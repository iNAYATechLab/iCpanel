# iCpanel backend configuration
# Copy this file to ".env" and adjust the values for your server.

# HTTP port for the API server
PORT=5000

# JWT settings — generate a long random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# Initial admin account (seeded on first start; change the password after login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Root directory exposed by the File Manager (production: /var/www)
FILES_BASE_DIR=/var/www

# Service control mode: auto | real | mock
#   auto -> uses systemctl when systemd is detected, otherwise simulated mode
#   real -> always use systemctl (production servers)
#   mock -> always simulated (development / demos without systemd)
SERVICE_MODE=auto

# Strict allowlist of services that may be controlled through the panel
ALLOWED_SERVICES=nginx,mysql,mariadb,postgresql,redis-server,docker,php8.3-fpm,apache2

# CORS origin for the frontend (use the URL of your dashboard in production)
CORS_ORIGIN=*
